# Reglas de caché para hostings que las leen (Netlify, Cloudflare Pages). GitHub Pages las ignora.
# Los archivos de /assets/ cambian de nombre en cada versión: se pueden guardar para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# La página y el guardado sin conexión se revisan siempre (así llega enseguida la versión nueva).
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

/img/*
  Cache-Control: public, max-age=604800
